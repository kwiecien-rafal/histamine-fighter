# Backend
DEBUG=true
# Browser origins allowed to call the API from JavaScript, and the trusted-Origin
# set for the cross-origin check on admin mutations. Admin auth rides in a
# same-origin session cookie, so the SPA and API must share an origin: in dev the
# Vite proxy fronts both on :5173; in production reverse-proxy /api and /admin under
# the SPA's host rather than a separate subdomain. To drive admin mutations from
# Swagger at :8000, add "http://localhost:8000" here (an unlisted Origin on a
# POST/PATCH/DELETE is refused with 403).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database connection (asyncpg driver). For native dev, localhost works.
# Inside Docker Compose, use the db service name as the host: ...@db:5432/histamine
DATABASE_URL=postgresql+asyncpg://histamine:histamine@localhost:5432/histamine

# Set true on the hosted/public deployment. Disables Ollama (which can't reach a
# visitor's localhost from a public server) and shifts the frontend default away
# from Ollama. Leave false for local dev and self-hosted setups.
PUBLIC_DEPLOYMENT=false

# Frontend mirror of PUBLIC_DEPLOYMENT — Vite only exposes vars prefixed VITE_.
# Must match PUBLIC_DEPLOYMENT for the UI to render the correct provider list.
VITE_PUBLIC_DEPLOYMENT=false

# Admin auth. SECRET_KEY signs the JWT issued at /admin/auth/login. Leave blank
# for local dev (it falls back to an insecure placeholder). Production refuses to
# start without a strong, non-default value (>=32 chars) once DEBUG=false or
# PUBLIC_DEPLOYMENT=true. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Name of the httpOnly session cookie set at /admin/auth/login. Its Secure flag is
# driven by PUBLIC_DEPLOYMENT (assumes HTTPS) and its lifetime tracks
# ACCESS_TOKEN_EXPIRE_MINUTES. Rarely needs changing.
SESSION_COOKIE_NAME=hf_session

# --- Public user accounts ---
# Public sessions (magic link / OAuth) last this many days; admins keep the short
# ACCESS_TOKEN_EXPIRE_MINUTES TTL even when they sign in through a public method.
USER_SESSION_EXPIRE_DAYS=30

# Where the SPA lives. The backend embeds this in magic-link emails and uses it as
# the post-OAuth redirect target. In production set it to the site origin and make
# sure the same origin is listed in CORS_ORIGINS, or the browser's POST to
# /api/v1/auth/magic/verify is refused by the Origin check.
FRONTEND_BASE_URL=http://localhost:5173

# Magic-link login links (and their 6-digit codes) expire after this many minutes;
# the attempt cap bounds online guessing of a code.
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_MAX_ATTEMPTS=5

# Resend (https://resend.com) sends the magic-link emails. Leave blank for dev or
# self-hosting: the link and code are then written to the backend log instead of
# being emailed, so login still works with zero external services. EMAIL_FROM must
# be a sender on a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Histamine Fighter <login@histaminefighter.com>"

# Cloudflare Turnstile (free) blocks scripted signups on the magic-link form.
# Leave both blank to skip verification (dev/self-hosted). The secret stays server
# side; the site key is public and read by the frontend via VITE_.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# OAuth sign-in. A provider with either value blank is disabled (its login button
# still renders but /start answers 501), so self-hosters need no OAuth apps.
# Redirect URI to register: {backend origin}/api/v1/auth/oauth/{provider}/callback
# Google: https://console.cloud.google.com/apis/credentials
# GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Shared LLM tier ---
# Signed-in users can select the "shared" provider: LLM calls then run on the
# server's OPENAI_API_KEY, hard-pinned to SHARED_MODEL (client model/key headers
# are ignored). Requires OPENAI_API_KEY below; without it the tier answers 501.
# Pair with a hard monthly budget cap on the OpenAI project as the last-resort
# spend ceiling.
SHARED_MODEL=gpt-5.4-mini

# Daily request ceilings for the shared tier, per UTC day. A request must clear
# all three: the caller's account limit, their IP's limit (so multi-accounting
# behind one connection gains nothing), and the site-wide global cap. IPv6
# clients are counted per /64, the typical subscriber allocation, so hopping
# addresses inside one allocation mints no fresh identities.
# SIGNUP_IP_DAILY_LIMIT caps new accounts created per IP per day.
SHARED_USER_DAILY_LIMIT=20
SHARED_IP_DAILY_LIMIT=40
SHARED_GLOBAL_DAILY_LIMIT=500
SIGNUP_IP_DAILY_LIMIT=3

# Magic-link sign-in emails one IP may trigger per UTC day. Bounds inbox bombing
# and Resend spend even when Turnstile is off; a hit answers the same uniform 200
# without sending, so it reveals nothing.
MAGIC_SEND_IP_DAILY_LIMIT=20

# Behind a reverse proxy / Cloudflare, run uvicorn with --proxy-headers and
# --forwarded-allow-ips=<proxy IPs> so per-IP limits key on the real client
# address, and ensure the origin only accepts traffic from the proxy.

# Retention: run `python -m app.scripts.purge_auth_data` daily (cron, next to the
# meals generation job). It drops magic-link rows one day past expiry and usage
# counters after 30 days, so auth tables hold no personal data longer than needed.

# Hour (0-23) the daily board unlocks. Deliberately UTC, not local time, so the
# reveal is the same instant for every visitor. The generation script stamps each
# suggestion's reveal time from this.
DAILY_REVEAL_HOUR_UTC=10

# How many days back the public board can be browsed, and the retention the nightly
# cron prunes daily suggestions to, so stored history matches what can be shown.
DAILY_HISTORY_DAYS=7

# How many days of recent board names the composer is told not to repeat. 0 disables
# the do-not-repeat list.
DAILY_VARIETY_WINDOW_DAYS=14

# How many moderately compatible ingredients a composed meal may keep, each carried
# with the index's moderation note. 0 restores the strict all-well-tolerated gate.
# Incompatible and poorly tolerated ingredients always block regardless.
COMPOSER_MAX_MODERATE_INGREDIENTS=2

# Whether an LLM judge quality-reviews each composed meal before it is accepted
# (one extra structured call per accepted meal), and how many of its five yes/no
# criteria must pass. Quality only; the code-owned safety gate runs regardless.
COMPOSER_JUDGE_ENABLED=true
COMPOSER_JUDGE_THRESHOLD=4

# Server-side fallback LLM provider when the request carries no X-LLM-Provider header.
# One of: ollama | openai | anthropic | gemini | openrouter. The web app always sends
# the header, so this only matters for direct API calls (curl, scripts).
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama or X-LLM-Provider: ollama).
# For native dev, localhost is fine. From inside Docker, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# --- HuggingFace (optional) ---
# On startup the backend downloads a small embedding model from HuggingFace.
# Anonymous downloads are rate-limited; if boot fails with "Server disconnected"
# or a "set a HF_TOKEN" warning, add a free read token to lift the limit.
# Create one (read scope is enough) at https://huggingface.co/settings/tokens
# Read directly by huggingface_hub; Docker Compose forwards it to the backend.
HF_TOKEN=

# --- Bring your own key (optional) ---
# Users normally paste their key in the web app's Settings panel; it travels as a
# per-request header and is never stored. The vars below are only a server-side
# fallback for local testing or self-hosting when no X-LLM-API-Key header is sent.
# OpenAI keys:     https://platform.openai.com/api-keys
# Anthropic keys:  https://console.anthropic.com/settings/keys
# Gemini keys:     https://aistudio.google.com/apikey
# OpenRouter keys: https://openrouter.ai/keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
